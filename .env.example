# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA versione o arquivo ".env" (já está no .gitignore).

# --- Conexão de administração (migrations, seeds, ETL) ---
POLO_DB_HOST=localhost
POLO_DB_PORT=5432
POLO_DB_NAME=polo_inovale
POLO_DB_USER=polo_admin
POLO_DB_PASSWORD=troque_esta_senha
POLO_DB_SCHEMA_SEARCH_PATH=raw,core,mart,etl,public

# --- Conexão somente-leitura usada pelo Power BI ---
# Criada pela migration de roles (db/roles/powerbi_readonly.sql).
# Gere uma senha forte e distribua apenas via cofre de segredos (não aqui).
POLO_BI_DB_USER=powerbi_readonly
POLO_BI_DB_PASSWORD=defina_uma_senha_forte_no_cofre_de_segredos

# --- ETL ---
POLO_ETL_QUARANTINE_DIR=etl/quarantine
POLO_ETL_LOG_LEVEL=INFO

# --- Google Sheets (opcional, futuro) ---
# Caminho para um arquivo de credenciais de service account do Google.
# O arquivo em si NUNCA deve ser commitado.
POLO_GSHEETS_CREDENTIALS_FILE=

# --- Admin web (Django) ---
# Role dedicada, criada pela migration de roles (db/roles/django_app.sql).
# Leitura/escrita em core, leitura em etl, sem acesso a raw/mart.
DJANGO_DB_USER=django_app
DJANGO_DB_PASSWORD=defina_uma_senha_forte_no_cofre_de_segredos

# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=troque_esta_chave
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
