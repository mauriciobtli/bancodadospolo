# Modelo do conjunto RESTRITO de variáveis de ambiente que o processo
# Django de PRODUÇÃO deve receber — nunca o .env administrativo completo
# da raiz do repositório (que tem POLO_DB_USER/POLO_DB_PASSWORD, a role
# de administração do banco, usada só por Alembic/ETL rodando fora do
# processo web).
#
# Como usar: injete estas variáveis diretamente no processo web pelo
# mecanismo do seu orquestrador (systemd EnvironmentFile=, variáveis de
# ambiente do container, Secret do Kubernetes, etc.) — nunca copiando o
# .env da raiz para a máquina/processo que serve a aplicação. Se preferir
# um arquivo .env também em produção, use ESTE conjunto de variáveis (não
# o da raiz) e mantenha-o só na máquina/processo do serviço web.
#
# NUNCA versione o arquivo real (.env.production, ou equivalente) —
# adicione-o ao .gitignore do seu ambiente de implantação, assim como
# ".env" já está aqui.

# Conexão: aponta para o mesmo banco (host/porta/nome), mas SEM
# credencial administrativa nenhuma.
POLO_DB_HOST=db.producao.exemplo
POLO_DB_PORT=5432
POLO_DB_NAME=polo_inovale

# Role dedicada do admin web (db/roles/django_app.sql): leitura/escrita
# em core, leitura em etl, sem acesso a raw/mart, sem CREATEDB.
DJANGO_DB_USER=django_app
DJANGO_DB_PASSWORD=defina_uma_senha_forte_no_cofre_de_segredos

# Role dedicada da importação via tela web (db/roles/web_import.sql):
# leitura/escrita em raw/core/etl sem DELETE/DDL, sem acesso a app/mart.
WEB_IMPORT_DB_USER=web_import
WEB_IMPORT_DB_PASSWORD=defina_uma_senha_forte_no_cofre_de_segredos

DJANGO_SECRET_KEY=troque_esta_chave
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=admin.polo-inovale.exemplo
DJANGO_CSRF_TRUSTED_ORIGINS=https://admin.polo-inovale.exemplo

# NÃO incluir aqui: POLO_DB_USER, POLO_DB_PASSWORD, POLO_BI_DB_USER,
# POLO_BI_DB_PASSWORD, DJANGO_TEST_DB_NAME (só usado pela suíte de
# testes, nunca pelo processo web real) — nenhuma dessas é necessária
# (nem deve estar acessível) para o serviço web servir tráfego real.
